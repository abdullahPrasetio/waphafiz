# ============================================================
# WAPHafiz — Production Environment
# Salin file ini: cp .env.prod.example .env.prod
# Jangan commit .env.prod ke git!
# ============================================================

# IP STB kamu di jaringan lokal (cek: ip addr show / Settings → Network di STB)
STB_IP=192.168.1.100

# Database
DB_NAME=waphafiz
DB_USER=waphafiz
DB_PASSWORD=ganti_dengan_password_kuat

# Redis (kosongkan jika tidak pakai password)
REDIS_PASSWORD=

# JWT — generate dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_secret_panjang_dan_random
